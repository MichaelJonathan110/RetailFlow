# Backend environment - copy to .env for local dev.
# Local Postgres (docker-compose maps 5434 -> 5432)
DATABASE_URL=postgresql://retailflow:change-me-local-dev@localhost:5434/retailflow
AUTH_ENABLED=false
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PYTHONUNBUFFERED=1
