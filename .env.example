# ---------------------------------------------------------------------------
# RetailFlow environment configuration.
# Copy to .env and adjust. NEVER commit the real .env (it is git-ignored).
# ---------------------------------------------------------------------------
# NOTE ON PORTS: this host already runs other projects on 5432 (postgres) and
# 8000 (an API). RetailFlow therefore uses 5434 and 8020 to avoid collisions.
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by docker-compose AND the API) ---
POSTGRES_DB=retailflow
POSTGRES_USER=retailflow
# Change this. It is only a local-development default.
POSTGRES_PASSWORD=change-me-local-dev
# Host port -> container 5432. 5434 avoids the other project on 5432.
POSTGRES_PORT=5434

# --- API ---
# Host-run API port (uvicorn). 8020 avoids the service already on 8000.
API_PORT=8020
# From the host, connecting to the Docker-published port:
DATABASE_URL=postgresql+psycopg://retailflow:change-me-local-dev@localhost:5434/retailflow
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Comma-separated. Both common front-end ports are allowed by default.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Upload limits ---
MAX_UPLOAD_MB=50
MAX_UPLOAD_ROWS=500000

# --- Defaults surfaced in the UI ---
DEFAULT_CURRENCY=BRL
DEFAULT_TIMEZONE=UTC
DEFAULT_PAGE_SIZE=25

# --- Feature flags ---
# Authentication: Bearer-token login (POST /auth/login). Turn ON for any
# deployment reachable beyond your own machine.
AUTH_ENABLED=false
# Signing key for session tokens. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL_MINUTES=480
# Bootstrap admin created on first start when app.app_user is empty.
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_NAME=RetailFlow Admin
AUTH_ADMIN_ROLE=administrator
AUTH_ADMIN_PASSWORD=change-me-too
DEMO_DATA_ENABLED=true
# Arbitrary SQL from a browser is a serious liability. Off by default.
SQL_EXPLORER_ENABLED=false
SQL_STATEMENT_TIMEOUT_MS=5000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE=http://localhost:8020/api/v1
