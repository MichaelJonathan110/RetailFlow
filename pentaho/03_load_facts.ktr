<?xml version="1.0" encoding="UTF-8"?>
<transformation><info><name>03 Load fact tables</name><description>Stage 3: fact_order_items (grain = order item) and fact_payments (grain = payment), idempotent NOT EXISTS (services/transform.py load_facts).</description><extended_description/><trans_version>1.0</trans_version><trans_type>Normal</trans_type><trans_status>0</trans_status><directory>/</directory><parameters></parameters><log></log><maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>Y</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><shared_objects_file/><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><dependencies></dependencies><partitionschemas></partitionschemas><slaveservers></slaveservers><clusterschemas></clusterschemas><created_user>RetailFlow</created_user><created_date>2026/10/30 00:00:00.000</created_date><modified_user>RetailFlow</modified_user><modified_date>2026/10/30 00:00:00.000</modified_date><key_for_session_key/><is_key_private>N</is_key_private></info>
<notepads><notepad><note>Stage 3  Load facts
fact_order_items : 1 row per (order_id, order_item_id), surrogate keys from dim_* (current customer version)
fact_payments    : 1 row per (order_id, payment_sequential)
NOT EXISTS makes re-runs idempotent.</note><xloc>48</xloc><yloc>32</yloc><width>960</width><heigth>130</heigth><fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic><fontcolorred>14</fontcolorred><fontcolorgreen>13</fontcolorgreen><fontcolorblue>15</fontcolorblue><backgroundcolorred>254</backgroundcolorred><backgroundcolorgreen>208</backgroundcolorgreen><backgroundcolorblue>26</backgroundcolorblue><bordercolorred>14</bordercolorred><bordercolorgreen>13</bordercolorgreen><bordercolorblue>15</bordercolorblue><drawshadow>Y</drawshadow></notepad></notepads>
<connection><name>RetailFlow-PostgreSQL</name><server>${RF_DB_HOST}</server><type>POSTGRESQL</type><access>Native</access><database>${RF_DB_NAME}</database><port>${RF_DB_PORT}</port><username>${RF_DB_USER}</username><password>${RF_DB_PASSWORD}</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>${RF_DB_PORT}</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute></attributes></connection>
<order><hop><from>Start</from><to>Insert fact_order_items</to><enabled>Y</enabled></hop><hop><from>Insert fact_order_items</from><to>Insert fact_payments</to><enabled>Y</enabled></hop><hop><from>Insert fact_payments</from><to>Log fact counts</to><enabled>Y</enabled></hop><hop><from>Log fact counts</from><to>Write stage log (ops.etl_stage_log)</to><enabled>Y</enabled></hop></order>
<step><name>Start</name><type>RowGenerator</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>pipeline</name><type>String</type><format/><currency/><decimal/><group/><nullif>RetailFlow</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field></fields><limit>1</limit><never_ending>N</never_ending><interval_in_ms>5000</interval_in_ms><row_time_field>now</row_time_field><last_time_field>FiveSecondsAgo</last_time_field><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>64</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Insert fact_order_items</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>INSERT INTO warehouse.fact_order_items (
    order_id, order_item_id, date_key, customer_sk, product_sk, seller_sk,
    geography_sk, order_status, purchase_ts, quantity, price, freight_value,
    total_item_value, batch_id
)
SELECT
    s.order_id,
    s.order_item_id::int,
    to_char(s.order_purchase_ts::timestamptz, 'YYYYMMDD')::int,
    c.customer_sk, p.product_sk, se.seller_sk, g.geography_sk,
    lower(s.order_status),
    s.order_purchase_ts::timestamptz,
    1,
    s.price::numeric(12,2),
    coalesce(nullif(s.freight_value, '')::numeric(12,2), 0),
    s.price::numeric(12,2) + coalesce(nullif(s.freight_value, '')::numeric(12,2), 0),
    s.batch_id
FROM staging.stg_order_items s
JOIN warehouse.dim_product p  ON p.product_id  = s.product_id
JOIN warehouse.dim_seller  se ON se.seller_id  = s.seller_id
JOIN warehouse.dim_customer c ON c.customer_id = s.customer_id AND c.is_current
LEFT JOIN warehouse.dim_geography g
       ON g.city = nullif(trim(s.customer_city), '') AND g.state = upper(trim(s.customer_state))
WHERE s.validation_status = 'valid'
  AND s.order_id IS NOT NULL
  AND s.order_item_id IS NOT NULL
  AND s.price IS NOT NULL
  AND s.order_purchase_ts IS NOT NULL
  AND NOT EXISTS (
      SELECT 1 FROM warehouse.fact_order_items f
      WHERE f.order_id = s.order_id AND f.order_item_id = s.order_item_id::int)</sql><set_params>N</set_params><insert_field>fact_order_items_inserted</insert_field><update_field>fact_order_items_updated</update_field><delete_field>fact_order_items_deleted</delete_field><read_field>fact_order_items_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>256</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Insert fact_payments</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>INSERT INTO warehouse.fact_payments (order_id, payment_sequential, date_key, payment_type, payment_value, batch_id)
SELECT p.order_id, p.payment_sequential::int,
       (SELECT min(f.date_key) FROM warehouse.fact_order_items f WHERE f.order_id = p.order_id),
       lower(coalesce(nullif(p.payment_type, ''), 'unknown')),
       p.payment_value::numeric(12,2),
       p.batch_id
FROM staging.stg_payments p
WHERE p.validation_status = 'valid'
  AND p.order_id IS NOT NULL AND p.payment_sequential IS NOT NULL
  AND p.payment_value IS NOT NULL
  AND NOT EXISTS (
      SELECT 1 FROM warehouse.fact_payments f
      WHERE f.order_id = p.order_id AND f.payment_sequential = p.payment_sequential::int)</sql><set_params>N</set_params><insert_field>fact_payments_inserted</insert_field><update_field>fact_payments_updated</update_field><delete_field>fact_payments_deleted</delete_field><read_field>fact_payments_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>448</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Log fact counts</name><type>WriteToLog</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><loglevel>log_level_basic</loglevel><displayHeader>Y</displayHeader><limitRows>N</limitRows><limitRowsNumber>0</limitRowsNumber><logmessage>RetailFlow fact load</logmessage><fields></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>640</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Write stage log (ops.etl_stage_log)</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>INSERT INTO ops.etl_stage_log (run_id, stage_order, stage_name, stage_kind, status, rows_in, rows_out, rows_rejected, started_at, finished_at, duration_ms, message) SELECT r.run_id, 3, 'Load fact tables', 'load', 'succeeded', (SELECT count(*) FROM staging.stg_order_items WHERE validation_status = 'valid'), (SELECT (SELECT count(*) FROM warehouse.fact_order_items) + (SELECT count(*) FROM warehouse.fact_payments)), (0), now(), now(), 0, (SELECT 'fact_order_items=' || (SELECT count(*) FROM warehouse.fact_order_items) || ', fact_payments=' || (SELECT count(*) FROM warehouse.fact_payments) || ' (totals after Pentaho load)') FROM (SELECT (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') AS run_id) r WHERE r.run_id IS NOT NULL</sql><set_params>N</set_params><insert_field>stage_inserted</insert_field><update_field>stage_updated</update_field><delete_field>stage_deleted</delete_field><read_field>stage_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>832</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step_error_handling></step_error_handling><slave-step-copy-partition-distribution></slave-step-copy-partition-distribution><slave_transformation>N</slave_transformation><attributes/></transformation>
