<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>04 - Load fact order items</name>
    <description>RetailFlow: 04 - Load fact order items</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <trans_status>0</trans_status>
    <directory>/RetailFlow</directory>
    <parameters/>
  </info>
  <connection>
    <name>RetailFlow-PostgreSQL</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>retailflow</database>
    <port>5432</port>
    <username>retailflow</username>
    <password>Encrypted </password>
  </connection>
  <order>

  </order>
  <step>
    <name>Load fact_order_items</name>
    <type>ExecuteSQL</type>
    <description>Insert validated rows that are not already present</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>RetailFlow-PostgreSQL</connection>
    <sql>INSERT INTO warehouse.fact_order_items (order_id, order_item_id, date_key, customer_sk, product_sk, seller_sk, order_status, purchase_ts, quantity, price, freight_value, total_item_value) SELECT s.order_id, s.order_item_id::int, to_char(s.order_purchase_ts::timestamptz,'YYYYMMDD')::int, c.customer_sk, p.product_sk, se.seller_sk, lower(s.order_status), s.order_purchase_ts::timestamptz, 1, s.price::numeric(12,2), coalesce(nullif(s.freight_value,'')::numeric(12,2),0), s.price::numeric(12,2) + coalesce(nullif(s.freight_value,'')::numeric(12,2),0) FROM staging.stg_order_items s JOIN warehouse.dim_product p ON p.product_id = s.product_id JOIN warehouse.dim_seller se ON se.seller_id = s.seller_id JOIN warehouse.dim_customer c ON c.customer_id = s.customer_id AND c.is_current WHERE s.validation_status='valid' AND s.order_id IS NOT NULL AND s.order_item_id IS NOT NULL AND s.price IS NOT NULL AND s.order_purchase_ts IS NOT NULL AND NOT EXISTS (SELECT 1 FROM warehouse.fact_order_items f WHERE f.order_id = s.order_id AND f.order_item_id = s.order_item_id::int)</sql>
  </step>
  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
</transformation>
