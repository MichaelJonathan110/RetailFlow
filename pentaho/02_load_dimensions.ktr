<?xml version="1.0" encoding="UTF-8"?>
<transformation><info><name>02 Load dimensions (SCD2)</name><description>Stage 2: dim_product upsert, dim_seller, dim_geography, dim_customer SCD Type 2 (same SQL as services/transform.py load_dimensions).</description><extended_description/><trans_version>1.0</trans_version><trans_type>Normal</trans_type><trans_status>0</trans_status><directory>/</directory><parameters></parameters><log></log><maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>Y</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><shared_objects_file/><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><dependencies></dependencies><partitionschemas></partitionschemas><slaveservers></slaveservers><clusterschemas></clusterschemas><created_user>RetailFlow</created_user><created_date>2026/10/30 00:00:00.000</created_date><modified_user>RetailFlow</modified_user><modified_date>2026/10/30 00:00:00.000</modified_date><key_for_session_key/><is_key_private>N</is_key_private></info>
<notepads><notepad><note>Stage 2  Load dimensions
dim_product  : upsert (ON CONFLICT DO UPDATE)
dim_seller   : insert new
dim_geography: city/state + Brazil region map
dim_customer : SCD Type 2 = insert new, close changed version (valid_to, is_current=false), open version+1
dim_date is a static calendar seeded 2016-2020.</note><xloc>48</xloc><yloc>32</yloc><width>1728</width><heigth>130</heigth><fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic><fontcolorred>14</fontcolorred><fontcolorgreen>13</fontcolorgreen><fontcolorblue>15</fontcolorblue><backgroundcolorred>254</backgroundcolorred><backgroundcolorgreen>208</backgroundcolorgreen><backgroundcolorblue>26</backgroundcolorblue><bordercolorred>14</bordercolorred><bordercolorgreen>13</bordercolorgreen><bordercolorblue>15</bordercolorblue><drawshadow>Y</drawshadow></notepad></notepads>
<connection><name>RetailFlow-PostgreSQL</name><server>${RF_DB_HOST}</server><type>POSTGRESQL</type><access>Native</access><database>${RF_DB_NAME}</database><port>${RF_DB_PORT}</port><username>${RF_DB_USER}</username><password>${RF_DB_PASSWORD}</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>${RF_DB_PORT}</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute></attributes></connection>
<order><hop><from>Start</from><to>Upsert dim_product</to><enabled>Y</enabled></hop><hop><from>Upsert dim_product</from><to>Insert dim_seller</to><enabled>Y</enabled></hop><hop><from>Insert dim_seller</from><to>Insert dim_geography</to><enabled>Y</enabled></hop><hop><from>Insert dim_geography</from><to>SCD2 insert new customers</to><enabled>Y</enabled></hop><hop><from>SCD2 insert new customers</from><to>SCD2 close changed versions</to><enabled>Y</enabled></hop><hop><from>SCD2 close changed versions</from><to>SCD2 open new versions</to><enabled>Y</enabled></hop><hop><from>SCD2 open new versions</from><to>Log dimension counts</to><enabled>Y</enabled></hop><hop><from>Log dimension counts</from><to>Write stage log (ops.etl_stage_log)</to><enabled>Y</enabled></hop></order>
<step><name>Start</name><type>RowGenerator</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>pipeline</name><type>String</type><format/><currency/><decimal/><group/><nullif>RetailFlow</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field></fields><limit>1</limit><never_ending>N</never_ending><interval_in_ms>5000</interval_in_ms><row_time_field>now</row_time_field><last_time_field>FiveSecondsAgo</last_time_field><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>64</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Upsert dim_product</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>INSERT INTO warehouse.dim_product (product_id, product_category, product_name)
SELECT DISTINCT ON (product_id) product_id, product_category, product_name
FROM staging.stg_products
WHERE product_id IS NOT NULL AND validation_status = 'valid'
ORDER BY product_id, created_at DESC, stg_id DESC
ON CONFLICT (product_id) DO UPDATE
  SET product_category = coalesce(EXCLUDED.product_category, warehouse.dim_product.product_category),
      product_name = coalesce(EXCLUDED.product_name, warehouse.dim_product.product_name),
      updated_at = now()</sql><set_params>N</set_params><insert_field>dim_product_inserted</insert_field><update_field>dim_product_updated</update_field><delete_field>dim_product_deleted</delete_field><read_field>dim_product_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>256</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Insert dim_seller</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>INSERT INTO warehouse.dim_seller (seller_id, seller_city, seller_state)
SELECT DISTINCT seller_id, seller_city, seller_state
FROM staging.stg_sellers
WHERE seller_id IS NOT NULL AND validation_status = 'valid'
ON CONFLICT (seller_id) DO NOTHING</sql><set_params>N</set_params><insert_field>dim_seller_inserted</insert_field><update_field>dim_seller_updated</update_field><delete_field>dim_seller_deleted</delete_field><read_field>dim_seller_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>448</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Insert dim_geography</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>WITH region_map (state, region) AS (VALUES
  ('AC','North'),('AP','North'),('AM','North'),('PA','North'),('RO','North'),('RR','North'),('TO','North'),
  ('AL','Northeast'),('BA','Northeast'),('CE','Northeast'),('MA','Northeast'),('PB','Northeast'),
  ('PE','Northeast'),('PI','Northeast'),('RN','Northeast'),('SE','Northeast'),
  ('DF','Central-West'),('GO','Central-West'),('MT','Central-West'),('MS','Central-West'),
  ('ES','Southeast'),('MG','Southeast'),('RJ','Southeast'),('SP','Southeast'),
  ('PR','South'),('RS','South'),('SC','South')
)
INSERT INTO warehouse.dim_geography (city, state, region)
SELECT DISTINCT nullif(trim(customer_city), ''), upper(trim(customer_state)), rm.region
FROM staging.stg_order_items s JOIN region_map rm ON rm.state = upper(trim(s.customer_state))
WHERE nullif(trim(s.customer_city), '') IS NOT NULL
ON CONFLICT (city, state) DO NOTHING</sql><set_params>N</set_params><insert_field>dim_geography_inserted</insert_field><update_field>dim_geography_updated</update_field><delete_field>dim_geography_deleted</delete_field><read_field>dim_geography_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>640</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>SCD2 insert new customers</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>WITH incoming AS (
    SELECT DISTINCT ON (customer_id) customer_id, customer_unique_id,
           nullif(trim(customer_city), '') AS customer_city,
           upper(trim(customer_state)) AS customer_state
    FROM staging.stg_customers
    WHERE customer_id IS NOT NULL AND validation_status = 'valid'
    ORDER BY customer_id, created_at DESC, stg_id DESC
)
INSERT INTO warehouse.dim_customer (customer_id, customer_unique_id, customer_city, customer_state)
SELECT i.customer_id, i.customer_unique_id, i.customer_city, i.customer_state
FROM incoming i
WHERE NOT EXISTS (SELECT 1 FROM warehouse.dim_customer d WHERE d.customer_id = i.customer_id)</sql><set_params>N</set_params><insert_field>cust_new_inserted</insert_field><update_field>cust_new_updated</update_field><delete_field>cust_new_deleted</delete_field><read_field>cust_new_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>832</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>SCD2 close changed versions</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>WITH incoming AS (
    SELECT DISTINCT ON (customer_id) customer_id, customer_unique_id,
           nullif(trim(customer_city), '') AS customer_city,
           upper(trim(customer_state)) AS customer_state
    FROM staging.stg_customers
    WHERE customer_id IS NOT NULL AND validation_status = 'valid'
    ORDER BY customer_id, created_at DESC, stg_id DESC
)
UPDATE warehouse.dim_customer d
SET valid_to = now(), is_current = false
FROM incoming i
WHERE d.customer_id = i.customer_id AND d.is_current
  AND (coalesce(d.customer_city, '') IS DISTINCT FROM coalesce(i.customer_city, '')
    OR coalesce(d.customer_state, '') IS DISTINCT FROM coalesce(i.customer_state, ''))</sql><set_params>N</set_params><insert_field>cust_closed_inserted</insert_field><update_field>cust_closed_updated</update_field><delete_field>cust_closed_deleted</delete_field><read_field>cust_closed_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1024</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>SCD2 open new versions</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>WITH incoming AS (
    SELECT DISTINCT ON (customer_id) customer_id, customer_unique_id,
           nullif(trim(customer_city), '') AS customer_city,
           upper(trim(customer_state)) AS customer_state
    FROM staging.stg_customers
    WHERE customer_id IS NOT NULL AND validation_status = 'valid'
    ORDER BY customer_id, created_at DESC, stg_id DESC
),
latest AS (
    SELECT customer_id, max(version) AS version FROM warehouse.dim_customer GROUP BY customer_id
)
INSERT INTO warehouse.dim_customer (customer_id, customer_unique_id, customer_city, customer_state, version)
SELECT i.customer_id,
       (SELECT customer_unique_id FROM warehouse.dim_customer x
         WHERE x.customer_id = i.customer_id ORDER BY version DESC LIMIT 1),
       i.customer_city, i.customer_state, l.version + 1
FROM incoming i JOIN latest l ON l.customer_id = i.customer_id
WHERE NOT EXISTS (
    SELECT 1 FROM warehouse.dim_customer c
    WHERE c.customer_id = i.customer_id AND c.is_current)</sql><set_params>N</set_params><insert_field>cust_versioned_inserted</insert_field><update_field>cust_versioned_updated</update_field><delete_field>cust_versioned_deleted</delete_field><read_field>cust_versioned_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1216</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Log dimension counts</name><type>WriteToLog</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><loglevel>log_level_basic</loglevel><displayHeader>Y</displayHeader><limitRows>N</limitRows><limitRowsNumber>0</limitRowsNumber><logmessage>RetailFlow dimension load</logmessage><fields></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1408</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Write stage log (ops.etl_stage_log)</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>INSERT INTO ops.etl_stage_log (run_id, stage_order, stage_name, stage_kind, status, rows_in, rows_out, rows_rejected, started_at, finished_at, duration_ms, message) SELECT r.run_id, 2, 'Load dimensions (SCD2)', 'load', 'succeeded', (SELECT count(*) FROM staging.stg_order_items WHERE validation_status = 'valid'), (SELECT (SELECT count(*) FROM warehouse.dim_product) + (SELECT count(*) FROM warehouse.dim_seller) + (SELECT count(*) FROM warehouse.dim_geography) + (SELECT count(*) FROM warehouse.dim_customer WHERE is_current)), (0), now(), now(), 0, (SELECT 'dim_product=' || (SELECT count(*) FROM warehouse.dim_product) || ', dim_seller=' || (SELECT count(*) FROM warehouse.dim_seller) || ', dim_geography=' || (SELECT count(*) FROM warehouse.dim_geography) || ', dim_customer_current=' || (SELECT count(*) FROM warehouse.dim_customer WHERE is_current) || ' (totals after Pentaho load)') FROM (SELECT (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') AS run_id) r WHERE r.run_id IS NOT NULL</sql><set_params>N</set_params><insert_field>stage_inserted</insert_field><update_field>stage_updated</update_field><delete_field>stage_deleted</delete_field><read_field>stage_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>1600</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step_error_handling></step_error_handling><slave-step-copy-partition-distribution></slave-step-copy-partition-distribution><slave_transformation>N</slave_transformation><attributes/></transformation>
