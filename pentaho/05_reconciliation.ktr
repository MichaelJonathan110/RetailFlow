<?xml version="1.0" encoding="UTF-8"?>
<transformation><info><name>05 Revenue reconciliation</name><description>Stage 5: compare fact_order_items vs fact_payments totals with 0.5% tolerance (services/reconciliation.py).</description><extended_description/><trans_version>1.0</trans_version><trans_type>Normal</trans_type><trans_status>0</trans_status><directory>/</directory><parameters></parameters><log></log><maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>Y</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><shared_objects_file/><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><dependencies></dependencies><partitionschemas></partitionschemas><slaveservers></slaveservers><clusterschemas></clusterschemas><created_user>RetailFlow</created_user><created_date>2026/10/30 00:00:00.000</created_date><modified_user>RetailFlow</modified_user><modified_date>2026/10/30 00:00:00.000</modified_date><key_for_session_key/><is_key_private>N</is_key_private></info>
<notepads><notepad><note>Stage 5  Reconcile
revenue_total: sum(price) vs sum(payment_value)
order_count  : distinct orders in each fact
matched if |difference| &lt;= 0.5% of source, else mismatch.</note><xloc>48</xloc><yloc>32</yloc><width>768</width><heigth>130</heigth><fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic><fontcolorred>14</fontcolorred><fontcolorgreen>13</fontcolorgreen><fontcolorblue>15</fontcolorblue><backgroundcolorred>254</backgroundcolorred><backgroundcolorgreen>208</backgroundcolorgreen><backgroundcolorblue>26</backgroundcolorblue><bordercolorred>14</bordercolorred><bordercolorgreen>13</bordercolorgreen><bordercolorblue>15</bordercolorblue><drawshadow>Y</drawshadow></notepad></notepads>
<connection><name>RetailFlow-PostgreSQL</name><server>${RF_DB_HOST}</server><type>POSTGRESQL</type><access>Native</access><database>${RF_DB_NAME}</database><port>${RF_DB_PORT}</port><username>${RF_DB_USER}</username><password>${RF_DB_PASSWORD}</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>${RF_DB_PORT}</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute></attributes></connection>
<order><hop><from>Start</from><to>Reconcile totals</to><enabled>Y</enabled></hop><hop><from>Reconcile totals</from><to>Write stage log (ops.etl_stage_log)</to><enabled>Y</enabled></hop><hop><from>Write stage log (ops.etl_stage_log)</from><to>Log reconciliation counters</to><enabled>Y</enabled></hop></order>
<step><name>Start</name><type>RowGenerator</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>pipeline</name><type>String</type><format/><currency/><decimal/><group/><nullif>RetailFlow</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field></fields><limit>1</limit><never_ending>N</never_ending><interval_in_ms>5000</interval_in_ms><row_time_field>now</row_time_field><last_time_field>FiveSecondsAgo</last_time_field><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>64</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Reconcile totals</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>INSERT INTO ops.data_reconciliation_results (run_id, check_code, description, source_value, target_value, difference, tolerance, status, checked_at)
SELECT (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running'), c.code, c.note, c.s, c.t, round(c.t - c.s, 2), round(abs(c.s) * 0.005, 2),
       CASE WHEN abs(round(c.t - c.s, 2)) &lt;= round(abs(c.s) * 0.005, 2) THEN 'matched' ELSE 'mismatch' END, now()
FROM analytics.v_revenue_reconciliation v
CROSS JOIN LATERAL (VALUES
  ('revenue_total', 'Item revenue (sum of price) vs payment revenue (sum of payment_value).', v.order_items_revenue::numeric, v.payments_revenue::numeric),
  ('order_count', 'Distinct orders present in each fact table.', v.order_item_orders::numeric, v.payment_orders::numeric)
) AS c(code, note, s, t)</sql><set_params>N</set_params><insert_field>recon_inserted</insert_field><update_field>recon_updated</update_field><delete_field>recon_deleted</delete_field><read_field>recon_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>256</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Write stage log (ops.etl_stage_log)</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>INSERT INTO ops.etl_stage_log (run_id, stage_order, stage_name, stage_kind, status, rows_in, rows_out, rows_rejected, started_at, finished_at, duration_ms, message) SELECT r.run_id, 5, 'Reconcile totals', 'reconcile', 'succeeded', (SELECT count(*) FROM ops.data_reconciliation_results WHERE run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running')), (SELECT count(*) FROM ops.data_reconciliation_results WHERE run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') AND status = 'matched'), (SELECT count(*) FROM ops.data_reconciliation_results WHERE run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') AND status = 'mismatch'), now(), now(), 0, (SELECT string_agg(check_code || ': source=' || round(source_value, 2) || ' target=' || round(target_value, 2) || ' ' || status, '; ' ORDER BY recon_id) FROM ops.data_reconciliation_results WHERE run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running')) FROM (SELECT (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') AS run_id) r WHERE r.run_id IS NOT NULL</sql><set_params>N</set_params><insert_field>stage_inserted</insert_field><update_field>stage_updated</update_field><delete_field>stage_deleted</delete_field><read_field>stage_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>448</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Log reconciliation counters</name><type>WriteToLog</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><loglevel>log_level_basic</loglevel><displayHeader>Y</displayHeader><limitRows>N</limitRows><limitRowsNumber>0</limitRowsNumber><logmessage>RetailFlow reconciliation</logmessage><fields></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>640</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step_error_handling></step_error_handling><slave-step-copy-partition-distribution></slave-step-copy-partition-distribution><slave_transformation>N</slave_transformation><attributes/></transformation>
