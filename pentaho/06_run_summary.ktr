<?xml version="1.0" encoding="UTF-8"?>
<transformation><info><name>06 Run summary</name><description>Read-only report printed at the end of the master job: star-schema row counts, DQ results and reconciliation results of this run.</description><extended_description/><trans_version>1.0</trans_version><trans_type>Normal</trans_type><trans_status>0</trans_status><directory>/</directory><parameters></parameters><log></log><maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>Y</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><shared_objects_file/><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><dependencies></dependencies><partitionschemas></partitionschemas><slaveservers></slaveservers><clusterschemas></clusterschemas><created_user>RetailFlow</created_user><created_date>2026/10/30 00:00:00.000</created_date><modified_user>RetailFlow</modified_user><modified_date>2026/10/30 00:00:00.000</modified_date><key_for_session_key/><is_key_private>N</is_key_private></info>
<notepads><notepad><note>Run summary (read-only)
Star schema: 5 dimensions (dim_date, dim_customer, dim_product, dim_seller, dim_geography) + 2 facts (fact_order_items, fact_payments).
Prints DQ and reconciliation results of the current Pentaho run to the log.</note><xloc>48</xloc><yloc>32</yloc><width>560</width><heigth>130</heigth><fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic><fontcolorred>14</fontcolorred><fontcolorgreen>13</fontcolorgreen><fontcolorblue>15</fontcolorblue><backgroundcolorred>254</backgroundcolorred><backgroundcolorgreen>208</backgroundcolorgreen><backgroundcolorblue>26</backgroundcolorblue><bordercolorred>14</bordercolorred><bordercolorgreen>13</bordercolorgreen><bordercolorblue>15</bordercolorblue><drawshadow>Y</drawshadow></notepad></notepads>
<connection><name>RetailFlow-PostgreSQL</name><server>${RF_DB_HOST}</server><type>POSTGRESQL</type><access>Native</access><database>${RF_DB_NAME}</database><port>${RF_DB_PORT}</port><username>${RF_DB_USER}</username><password>${RF_DB_PASSWORD}</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>${RF_DB_PORT}</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute></attributes></connection>
<order><hop><from>Dimension row counts</from><to>Log dimensions</to><enabled>Y</enabled></hop><hop><from>Fact row counts</from><to>Log facts</to><enabled>Y</enabled></hop><hop><from>DQ results of this run</from><to>Log DQ results</to><enabled>Y</enabled></hop><hop><from>Reconciliation of this run</from><to>Log reconciliation results</to><enabled>Y</enabled></hop></order>
<step><name>Dimension row counts</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><sql>SELECT (SELECT count(*) FROM warehouse.dim_product) AS dim_product, (SELECT count(*) FROM warehouse.dim_seller) AS dim_seller, (SELECT count(*) FROM warehouse.dim_geography) AS dim_geography, (SELECT count(*) FROM warehouse.dim_customer) AS dim_customer_versions, (SELECT count(*) FROM warehouse.dim_customer WHERE is_current) AS dim_customer_current, (SELECT count(*) FROM warehouse.dim_date) AS dim_date</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>64</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Log dimensions</name><type>WriteToLog</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><loglevel>log_level_basic</loglevel><displayHeader>Y</displayHeader><limitRows>N</limitRows><limitRowsNumber>0</limitRowsNumber><logmessage>RetailFlow dimensions</logmessage><fields></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>256</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Fact row counts</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><sql>SELECT (SELECT count(*) FROM warehouse.fact_order_items) AS fact_order_items, (SELECT count(*) FROM warehouse.fact_payments) AS fact_payments</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>64</xloc><yloc>336</yloc><draw>Y</draw></GUI></step>
<step><name>Log facts</name><type>WriteToLog</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><loglevel>log_level_basic</loglevel><displayHeader>Y</displayHeader><limitRows>N</limitRows><limitRowsNumber>0</limitRowsNumber><logmessage>RetailFlow facts</logmessage><fields></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>256</xloc><yloc>336</yloc><draw>Y</draw></GUI></step>
<step><name>DQ results of this run</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><sql>SELECT r.rule_code, q.status, q.passed_count, q.failed_count, q.failure_rate FROM ops.data_quality_results q JOIN ops.data_quality_rules r USING (rule_id) WHERE q.run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') ORDER BY r.rule_id</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>64</xloc><yloc>448</yloc><draw>Y</draw></GUI></step>
<step><name>Log DQ results</name><type>WriteToLog</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><loglevel>log_level_basic</loglevel><displayHeader>Y</displayHeader><limitRows>N</limitRows><limitRowsNumber>0</limitRowsNumber><logmessage>RetailFlow data quality results</logmessage><fields></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>256</xloc><yloc>448</yloc><draw>Y</draw></GUI></step>
<step><name>Reconciliation of this run</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><sql>SELECT check_code, source_value, target_value, difference, tolerance, status FROM ops.data_reconciliation_results WHERE run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') ORDER BY recon_id</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>64</xloc><yloc>560</yloc><draw>Y</draw></GUI></step>
<step><name>Log reconciliation results</name><type>WriteToLog</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><loglevel>log_level_basic</loglevel><displayHeader>Y</displayHeader><limitRows>N</limitRows><limitRowsNumber>0</limitRowsNumber><logmessage>RetailFlow reconciliation results</logmessage><fields></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>256</xloc><yloc>560</yloc><draw>Y</draw></GUI></step>
<step_error_handling></step_error_handling><slave-step-copy-partition-distribution></slave-step-copy-partition-distribution><slave_transformation>N</slave_transformation><attributes/></transformation>
