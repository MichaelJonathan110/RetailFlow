<entry><name>06 Run summary</name><description/><type>TRANS</type><attributes/><specification_method>filename</specification_method><trans_object_id/><filename>${Internal.Entry.Current.Directory}/06_run_summary.ktr</filename><transname/><arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><cluster>N</cluster><slave_server_name/><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote><create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work><run_configuration>Pentaho local</run_configuration><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>1056</xloc><yloc>176</yloc><attributes_kjc/></entry>
<entry><name>Close run: succeeded</name><description/><type>SQL</type><attributes/><sql>UPDATE ops.etl_run_log r SET status = 'succeeded', finished_at = now(), duration_ms = round(extract(epoch FROM (now() - r.started_at)) * 1000, 2), rows_read = coalesce((SELECT rows_in FROM ops.etl_stage_log s WHERE s.run_id = r.run_id AND s.stage_order = 1 LIMIT 1), 0), rows_inserted = coalesce((SELECT sum(rows_out) FROM ops.etl_stage_log s WHERE s.run_id = r.run_id AND s.stage_kind = 'load'), 0), rows_rejected = coalesce((SELECT sum(rows_rejected) FROM ops.etl_stage_log s WHERE s.run_id = r.run_id), 0), execution_metadata = coalesce(r.execution_metadata, '{}'::jsonb) || jsonb_build_object('log', (SELECT jsonb_agg('stage ' || stage_order || ' ' || stage_name || ': ' || coalesce(message, '') ORDER BY stage_order) FROM ops.etl_stage_log s WHERE s.run_id = r.run_id)) WHERE r.run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running');</sql><useVariableSubstitution>Y</useVariableSubstitution><sqlfromfile>N</sqlfromfile><sqlfilename/><sendOneStatement>Y</sendOneStatement><connection>RetailFlow-PostgreSQL</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>1200</xloc><yloc>176</yloc><attributes_kjc/></entry>
<entry><name>Success</name><description/><type>SUCCESS</type><attributes/><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>1344</xloc><yloc>176</yloc><attributes_kjc/></entry>
<entry><name>Mark run failed</name><description/><type>SQL</type><attributes/><sql>UPDATE ops.etl_run_log r SET status = 'failed', finished_at = now(), duration_ms = round(extract(epoch FROM (now() - r.started_at)) * 1000, 2), error_summary = 'A Pentaho transformation failed - see the Kitchen/Spoon log' WHERE r.run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running');</sql><useVariableSubstitution>Y</useVariableSubstitution><sqlfromfile>N</sqlfromfile><sqlfilename/><sendOneStatement>Y</sendOneStatement><connection>RetailFlow-PostgreSQL</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>768</xloc><yloc>336</yloc><attributes_kjc/></entry>
<entry><name>Abort</name><description/><type>ABORT</type><attributes/><message>RetailFlow Pentaho master pipeline failed</message><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>912</xloc><yloc>336</yloc><attributes_kjc/></entry>
</entries>
