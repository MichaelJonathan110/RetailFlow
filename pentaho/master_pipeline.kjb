<entries>
<entry><name>START</name><description/><type>SPECIAL</type><attributes/><start>Y</start><dummy>N</dummy><repeat>N</repeat><schedulerType>0</schedulerType><intervalSeconds>0</intervalSeconds><intervalMinutes>60</intervalMinutes><hour>12</hour><minutes>0</minutes><weekDay>1</weekDay><DayOfMonth>1</DayOfMonth><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>48</xloc><yloc>176</yloc><attributes_kjc/></entry>
<entry><name>Open run (ops.etl_run_log)</name><description/><type>SQL</type><attributes/><sql>INSERT INTO ops.etl_run_log (run_uid, pipeline_id, trigger_type, engine, status, started_at, execution_metadata)
SELECT gen_random_uuid(), p.pipeline_id, 'pentaho', 'pentaho', 'running', now(), jsonb_build_object('engine', 'Pentaho Data Integration', 'job', 'master_pipeline.kjb')
FROM app.etl_pipeline p WHERE p.engine = 'pentaho' ORDER BY p.pipeline_id LIMIT 1;</sql><useVariableSubstitution>Y</useVariableSubstitution><sqlfromfile>N</sqlfromfile><sqlfilename/><sendOneStatement>Y</sendOneStatement><connection>RetailFlow-PostgreSQL</connection><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>192</xloc><yloc>176</yloc><attributes_kjc/></entry>
<entry><name>01 Extract from staging</name><description/><type>TRANS</type><attributes/><specification_method>filename</specification_method><trans_object_id/><filename>${Internal.Entry.Current.Directory}/01_extract_staging.ktr</filename><transname/><arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><cluster>N</cluster><slave_server_name/><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote><create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work><run_configuration>Pentaho local</run_configuration><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>336</xloc><yloc>176</yloc><attributes_kjc/></entry>
