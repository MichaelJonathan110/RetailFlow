      <attributes/>
      <sql>INSERT INTO ops.etl_run_log (run_uid, pipeline_id, trigger_type, engine, status, started_at, execution_metadata)
SELECT gen_random_uuid(), p.pipeline_id, 'pentaho', 'pentaho', 'running', now(), jsonb_build_object('engine', 'Pentaho Data Integration', 'job', 'master_pipeline.kjb')
FROM app.etl_pipeline p WHERE p.engine = 'pentaho' ORDER BY p.pipeline_id LIMIT 1;</sql>
