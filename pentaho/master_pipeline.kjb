    <entry>
      <name>Mark run failed</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>UPDATE ops.etl_run_log r SET status = 'failed', finished_at = now(), duration_ms = round(extract(epoch FROM (now() - r.started_at)) * 1000, 2), error_summary = 'A Pentaho transformation failed - see the Kitchen/Spoon log' WHERE r.run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running');</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>RetailFlow-PostgreSQL</connection>
      <parallel>N</parallel>
