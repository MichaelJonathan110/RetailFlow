    <entry>
      <name>Close run: succeeded</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>UPDATE ops.etl_run_log r SET status = 'succeeded', finished_at = now(), duration_ms = round(extract(epoch FROM (now() - r.started_at)) * 1000, 2), rows_read = coalesce((SELECT rows_in FROM ops.etl_stage_log s WHERE s.run_id = r.run_id AND s.stage_order = 1 LIMIT 1), 0), rows_inserted = coalesce((SELECT sum(rows_out) FROM ops.etl_stage_log s WHERE s.run_id = r.run_id AND s.stage_kind = 'load'), 0), rows_rejected = coalesce((SELECT sum(rows_rejected) FROM ops.etl_stage_log s WHERE s.run_id = r.run_id), 0), execution_metadata = coalesce(r.execution_metadata, '{}'::jsonb) || jsonb_build_object('log', (SELECT jsonb_agg('stage ' || stage_order || ' ' || stage_name || ': ' || coalesce(message, '') ORDER BY stage_order) FROM ops.etl_stage_log s WHERE s.run_id = r.run_id)) WHERE r.run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running');</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>RetailFlow-PostgreSQL</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>1200</xloc>
      <yloc>176</yloc>
      <attributes_kjc/>
    </entry>
