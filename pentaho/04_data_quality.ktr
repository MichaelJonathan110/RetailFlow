<?xml version="1.0" encoding="UTF-8"?>
<transformation><info><name>04 Data quality checks</name><description>Stage 4: re-evaluate the 12 active rules in ops.data_quality_rules against the warehouse; status passed/warning/failed (runner._run_quality).</description><extended_description/><trans_version>1.0</trans_version><trans_type>Normal</trans_type><trans_status>0</trans_status><directory>/</directory><parameters></parameters><log></log><maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>Y</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><shared_objects_file/><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><dependencies></dependencies><partitionschemas></partitionschemas><slaveservers></slaveservers><clusterschemas></clusterschemas><created_user>RetailFlow</created_user><created_date>2026/10/30 00:00:00.000</created_date><modified_user>RetailFlow</modified_user><modified_date>2026/10/30 00:00:00.000</modified_date><key_for_session_key/><is_key_private>N</is_key_private></info>
<notepads><notepad><note>Stage 4  Data quality
Warehouse rules: duplicate key, product/seller FK, price &gt;= 0, date 2016-2020, allowed status.
Other rules reuse the latest ingestion outcome.
Results -&gt; ops.data_quality_results (shown on the Quality page).</note><xloc>48</xloc><yloc>32</yloc><width>768</width><heigth>130</heigth><fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic><fontcolorred>14</fontcolorred><fontcolorgreen>13</fontcolorgreen><fontcolorblue>15</fontcolorblue><backgroundcolorred>254</backgroundcolorred><backgroundcolorgreen>208</backgroundcolorgreen><backgroundcolorblue>26</backgroundcolorblue><bordercolorred>14</bordercolorred><bordercolorgreen>13</bordercolorgreen><bordercolorblue>15</bordercolorblue><drawshadow>Y</drawshadow></notepad></notepads>
<connection><name>RetailFlow-PostgreSQL</name><server>${RF_DB_HOST}</server><type>POSTGRESQL</type><access>Native</access><database>${RF_DB_NAME}</database><port>${RF_DB_PORT}</port><username>${RF_DB_USER}</username><password>${RF_DB_PASSWORD}</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>${RF_DB_PORT}</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute></attributes></connection>
<order><hop><from>Start</from><to>Evaluate DQ rules</to><enabled>Y</enabled></hop><hop><from>Evaluate DQ rules</from><to>Write stage log (ops.etl_stage_log)</to><enabled>Y</enabled></hop><hop><from>Write stage log (ops.etl_stage_log)</from><to>Log DQ counters</to><enabled>Y</enabled></hop></order>
<step><name>Start</name><type>RowGenerator</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>pipeline</name><type>String</type><format/><currency/><decimal/><group/><nullif>RetailFlow</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field></fields><limit>1</limit><never_ending>N</never_ending><interval_in_ms>5000</interval_in_ms><row_time_field>now</row_time_field><last_time_field>FiveSecondsAgo</last_time_field><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>64</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Evaluate DQ rules</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>WITH chk AS (SELECT count(*)::numeric AS n FROM warehouse.fact_order_items),
ev AS (
  SELECT r.rule_id, r.dataset, r.severity,
    CASE r.rule_code
      WHEN 'OI_DUPLICATE_KEY' THEN (SELECT count(*) FROM (SELECT order_id, order_item_id FROM warehouse.fact_order_items GROUP BY order_id, order_item_id HAVING count(*) &gt; 1) d)
      WHEN 'OI_PRODUCT_REF' THEN (SELECT count(*) FROM warehouse.fact_order_items f LEFT JOIN warehouse.dim_product p ON p.product_sk = f.product_sk WHERE p.product_sk IS NULL)
      WHEN 'OI_SELLER_REF' THEN (SELECT count(*) FROM warehouse.fact_order_items f LEFT JOIN warehouse.dim_seller s ON s.seller_sk = f.seller_sk WHERE s.seller_sk IS NULL)
      WHEN 'OI_PRICE_NONNEGATIVE' THEN (SELECT count(*) FROM warehouse.fact_order_items WHERE price &lt; 0)
      WHEN 'OI_DATE_IN_RANGE' THEN (SELECT count(*) FROM warehouse.fact_order_items f JOIN warehouse.dim_date d USING (date_key) WHERE d.full_date &lt; DATE '2016-01-01' OR d.full_date &gt; DATE '2020-12-31')
      WHEN 'OI_STATUS_ALLOWED' THEN (SELECT count(*) FROM warehouse.fact_order_items WHERE order_status NOT IN ('delivered','shipped','canceled','unavailable','invoiced','processing','created','approved'))
      ELSE coalesce((SELECT q.failed_count FROM ops.data_quality_results q WHERE q.rule_id = r.rule_id ORDER BY q.last_executed_at DESC, q.result_id DESC LIMIT 1), 0)
    END::numeric AS f,
    CASE WHEN r.rule_code IN ('OI_DUPLICATE_KEY','OI_PRODUCT_REF','OI_SELLER_REF','OI_PRICE_NONNEGATIVE','OI_DATE_IN_RANGE','OI_STATUS_ALLOWED') THEN NULL
      ELSE (SELECT greatest(coalesce(q.passed_count, 0) + coalesce(q.failed_count, 0), 1) FROM ops.data_quality_results q WHERE q.rule_id = r.rule_id ORDER BY q.last_executed_at DESC, q.result_id DESC LIMIT 1)
    END::numeric AS prior_den
  FROM ops.data_quality_rules r WHERE r.is_active
),
x AS (SELECT ev.*, coalesce(ev.prior_den, nullif(chk.n, 0), 1) AS d FROM ev CROSS JOIN chk)
INSERT INTO ops.data_quality_results (run_id, rule_id, dataset, severity, passed_count, failed_count, failure_rate, status, last_executed_at)
SELECT (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running'), rule_id, dataset, severity, greatest(d - f, 0), f, least(round(f / d, 6), 1),
       CASE WHEN f = 0 THEN 'passed' WHEN f &lt; d THEN 'warning' ELSE 'failed' END, now()
FROM x</sql><set_params>N</set_params><insert_field>dq_inserted</insert_field><update_field>dq_updated</update_field><delete_field>dq_deleted</delete_field><read_field>dq_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>256</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Write stage log (ops.etl_stage_log)</name><type>ExecSQL</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>RetailFlow-PostgreSQL</connection><execute_each_row>Y</execute_each_row><single_statement>Y</single_statement><replace_variables>Y</replace_variables><quoteString>N</quoteString><sql>INSERT INTO ops.etl_stage_log (run_id, stage_order, stage_name, stage_kind, status, rows_in, rows_out, rows_rejected, started_at, finished_at, duration_ms, message) SELECT r.run_id, 4, 'Execute data quality rules', 'validate', 'succeeded', (SELECT count(*) FROM warehouse.fact_order_items), (SELECT count(*) FROM ops.data_quality_results WHERE run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') AND status = 'passed'), (SELECT count(*) FROM ops.data_quality_results WHERE run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') AND status &lt;&gt; 'passed'), now(), now(), 0, (SELECT (SELECT count(*) FROM ops.data_quality_results WHERE run_id = (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') AND status = 'passed') || '/' || (SELECT count(*) FROM ops.data_quality_rules WHERE is_active) || ' rules passed') FROM (SELECT (SELECT max(run_id) FROM ops.etl_run_log WHERE engine = 'pentaho' AND status = 'running') AS run_id) r WHERE r.run_id IS NOT NULL</sql><set_params>N</set_params><insert_field>stage_inserted</insert_field><update_field>stage_updated</update_field><delete_field>stage_deleted</delete_field><read_field>stage_read</read_field><arguments></arguments><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>448</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step><name>Log DQ counters</name><type>WriteToLog</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><loglevel>log_level_basic</loglevel><displayHeader>Y</displayHeader><limitRows>N</limitRows><limitRowsNumber>0</limitRowsNumber><logmessage>RetailFlow data quality</logmessage><fields></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>640</xloc><yloc>224</yloc><draw>Y</draw></GUI></step>
<step_error_handling></step_error_handling><slave-step-copy-partition-distribution></slave-step-copy-partition-distribution><slave_transformation>N</slave_transformation><attributes/></transformation>
